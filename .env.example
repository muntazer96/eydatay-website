# Public website configuration
# Copy to .env and adjust values for your environment.

# Backend API base URL (must end with /api)
NUXT_PUBLIC_API_BASE=https://eyadaty.techumbrella.net/api

# Public website canonical origin (no trailing slash). Used for canonical URLs,
# sitemap.xml and Open Graph links.
NUXT_PUBLIC_SITE_URL=https://eyadaty.techumbrella.net

# App store links — leave empty until the app is published on each store.
NUXT_PUBLIC_ANDROID_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.clinicbooking.clinic_app
NUXT_PUBLIC_IOS_APP_STORE_URL=

# Minimum age in ms a visitor must spend before the contact form is accepted
# (spam bots submit instantly). Kept in Nuxt runtime config; override via env.
NUXT_CONTACT_HONEYPOT_AGE_MS=4000